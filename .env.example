# Steleios — example environment.
#
# Copy to .env and fill in real values. .env is gitignored and MUST stay that
# way: secrets live in the environment, never in the repository (BR-SEC-07).
#
# Every value here has a default in internal/platform/config. Configuration is
# validated at startup and the process exits non-zero if it is invalid — there
# is no degraded start (HLT-005).

# ---- Deployment -------------------------------------------------------------
STELEIOS_ENV=local                 # local | test | staging | production
STELEIOS_VERSION=dev
STELEIOS_REVISION=unknown

# ---- HTTP -------------------------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=10s
HTTP_SHUTDOWN_GRACE=20s
HTTP_MAX_BODY_BYTES=1048576        # 1 MiB, enforced before parsing (DB-026)
HTTP_ALLOWED_ORIGINS=http://localhost:5173
HTTP_TRUSTED_PROXIES=              # RealIP is honoured only from these

# ---- PostgreSQL -------------------------------------------------------------
#
# The application connects as steleios_app, NEVER as a superuser or the table
# owner. PostgreSQL exempts both from row-level security entirely, so a
# superuser DSN would leave every tenant policy in place and no isolation at
# all — one shop's queries returning every shop's data, with nothing looking
# wrong. The pool refuses to start as such a role (ADR 0007).
POSTGRES_DSN=postgres://steleios_app:CHANGE_ME@localhost:5432/steleios_ecomm?sslmode=disable

# Privileged connection, used ONLY by migrations and by test setup that needs
# DDL. The running application never uses it.
POSTGRES_ADMIN_DSN=postgres://postgres:CHANGE_ME@localhost:5432/steleios_ecomm?sslmode=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
POSTGRES_CONNECT_TIMEOUT=5s
POSTGRES_STATEMENT_TIMEOUT=3s      # request-path ceiling (DB-012)
POSTGRES_IDLE_IN_TX_TIMEOUT=10s    # DB-034

# ---- Redis (sessions, cart, queue, rate limiting, idempotency) --------------
REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_TLS=false                    # MUST be true in production

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=debug                    # debug is prohibited in production (LOG-005)
LOG_FORMAT=text                    # must be json in production (LOG-001)

# ---- Security ---------------------------------------------------------------
SESSION_TTL=720h                   # 30 days sliding (SES-004)
ADMIN_SESSION_TTL=12h              # BR-ADM-07
COOKIE_DOMAIN=
COOKIE_SECURE=false                # MUST be true in production
HSTS_MAX_AGE=8760h

# ---- Payments ---------------------------------------------------------------
# Deliberately empty. Steleios records payments; it never processes them
# (ADR 0008). There is no gateway, no API key and no webhook secret — which is
# the point: there are no payment credentials to hold, rotate or leak, and no
# PCI scope of any size.
#
# Payment happens through the shop's own arrangements — cash, its UPI QR, its
# card terminal — and reconciliation against the bank statement is the control
# that turns a recorded payment into a known fact (BR-CPM-20).

# --- SMS (MSG91) ------------------------------------------------------------
# SMS is the channel Steleios treats as PROOF. Recovery, contact changes and
# first logins all verify against the registered mobile, because those flows
# assume the email may be lost or in someone else's hands (BR-REC-11).
#
# "log" writes what would have been sent and delivers nothing. Fine locally;
# config validation REFUSES it in production, where a silent no-op would mean
# every recovery code going nowhere and nobody finding out until an owner is
# locked out of their own business.
SMS_PROVIDER=log

# MSG91 credentials. Required when SMS_PROVIDER=msg91.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# DLT template ids. Under TRAI's rules a transactional SMS must match a template
# registered in advance with the operator, or the carrier drops it SILENTLY and
# still bills for it — so a missing id is a startup failure, not a runtime one.
MSG91_TEMPLATE_FIRST_LOGIN=
MSG91_TEMPLATE_OTP=
MSG91_TEMPLATE_RECOVERY_ISSUED=
MSG91_TEMPLATE_EMAIL_CHANGED=

# How long a password confirmation lasts for high-consequence actions: refunds,
# GST rates, role grants, client provisioning (BR-ADM-07).
REAUTH_WINDOW=15m
